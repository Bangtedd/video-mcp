# Copy to .env and adjust. Everything is optional except WEB_PASSWORD for the web app.

# Where inbox/, projects/, renders/ and cache/ live.
WORKSPACE_DIR=~/video-mcp/workspace

# HTTP bind address. Keep 127.0.0.1 unless you need access from other machines.
HOST=127.0.0.1
PORT=8765

# Required when HOST is not a loopback address; clients then send
# "Authorization: Bearer <AUTH_TOKEN>". Generate one with: openssl rand -hex 32
#AUTH_TOKEN=

# Font used for text overlays.
#FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Override the FFmpeg binaries if they are not on PATH.
#FFMPEG=ffmpeg
#FFPROBE=ffprobe

# ---- Web app (video-mcp-web) ----
# Required: the app refuses to start without a password. Pick a long one.
#WEB_PASSWORD=
# Listen on every interface so phones on your home network can reach it.
# Home network only: do not port-forward this port to the internet.
WEB_HOST=0.0.0.0
WEB_PORT=8780
# Per-file upload limit in MB.
#WEB_MAX_UPLOAD_MB=500

# Where template JSON files live (default: templates/ in the repo).
#TEMPLATES_DIR=~/video-mcp/templates
