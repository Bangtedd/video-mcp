# systemd user unit for video-mcp.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/video-mcp.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now video-mcp
#   sudo loginctl enable-linger "$USER"   # keep it running when logged out
#
# Assumes the repo is cloned to ~/video-mcp with a virtualenv in ~/video-mcp/.venv.
# Settings come from ~/video-mcp/.env (see .env.example).

[Unit]
Description=video-mcp: MCP server for editing video with FFmpeg
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/video-mcp
EnvironmentFile=-%h/video-mcp/.env
ExecStart=%h/video-mcp/.venv/bin/video-mcp
Restart=on-failure
RestartSec=3
# Renders are CPU heavy; keep the Pi responsive.
Nice=5

[Install]
WantedBy=default.target
